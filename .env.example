# Uses the same Databricks credentials as dataops-copilot.
# Copy from ../dataops-copilot/.env or create your own copy here.

USE_DATABRICKS=true
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=your_databricks_personal_access_token
DATABRICKS_WAREHOUSE_ID=your_sql_warehouse_id
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=dataops_copilot

# Portal runs on port 5001 (DataOps Copilot uses 5000)
PORT=5001
